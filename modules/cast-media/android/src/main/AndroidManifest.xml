<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Foreground service that keeps the media session alive (lock screen
       controls + volume buttons) while casting over UPnP. The app already
       declares the FOREGROUND_SERVICE(_MEDIA_PLAYBACK) permissions. -->
  <application>
    <service
      android:name="expo.modules.castmedia.CastMediaService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>
</manifest>
