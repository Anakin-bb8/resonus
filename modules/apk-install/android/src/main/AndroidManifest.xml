<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Declared, not requested: this one is granted at install time and cannot
       be asked for at runtime. What IS asked for, and only when somebody
       presses Update, is the "install unknown apps" toggle the system owns
       (`canInstall` / `openInstallSettings`). Without the permission here that
       toggle can't even be offered. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

  <application>
    <!-- The installer is another app: it cannot read our cache directory, so
         the APK goes over as a content:// with read permission granted for
         the one intent. -->
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.apkprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/apk_provider_paths" />
    </provider>
  </application>
</manifest>
