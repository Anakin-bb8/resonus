<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Allows installing on Android Automotive OS without requiring car hardware
       (so it also works as an Android Auto projection app on the phone). -->
  <uses-feature
    android:name="android.hardware.type.automotive"
    android:required="false" />

  <application>
    <!-- Declares the app as a media app for Android Auto (projection). -->
    <meta-data
      android:name="com.google.android.gms.car.application"
      android:resource="@xml/automotive_app_desc" />

    <service
      android:name="expo.modules.carauto.ResonusCarBrowserService"
      android:exported="true"
      android:foregroundServiceType="mediaPlayback">
      <intent-filter>
        <action android:name="androidx.media3.session.MediaLibraryService" />
        <action android:name="android.media.browse.MediaBrowserService" />
      </intent-filter>
    </service>
  </application>
</manifest>
