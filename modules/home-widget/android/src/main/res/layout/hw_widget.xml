<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hw_widget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:padding="10dp">

  <ImageView
    android:id="@+id/hw_cover"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:importantForAccessibility="no"
    android:scaleType="centerCrop"
    android:src="@drawable/hw_ic_note" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="4dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/hw_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/tile_label"
      android:textColor="@color/hw_widget_text"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/hw_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_idle"
      android:textColor="@color/hw_widget_secondary"
      android:textSize="13sp" />
  </LinearLayout>

  <ImageButton
    android:id="@+id/hw_previous"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@drawable/hw_button_background"
    android:contentDescription="@string/widget_previous"
    android:src="@drawable/hw_ic_previous" />

  <ImageButton
    android:id="@+id/hw_play_pause"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="@drawable/hw_button_background"
    android:contentDescription="@string/widget_play_pause"
    android:src="@drawable/hw_ic_play" />

  <ImageButton
    android:id="@+id/hw_next"
    android:layout_width="40dp"
    android:layout_height="40dp"
    android:background="@drawable/hw_button_background"
    android:contentDescription="@string/widget_next"
    android:src="@drawable/hw_ic_next" />
</LinearLayout>
