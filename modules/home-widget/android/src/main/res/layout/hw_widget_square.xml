<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/hw_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/hw_widget_background"
  android:clipToOutline="true">

  <ImageView
    android:id="@+id/hw_placeholder"
    android:layout_width="64dp"
    android:layout_height="64dp"
    android:layout_gravity="center"
    android:layout_marginBottom="32dp"
    android:importantForAccessibility="no"
    android:src="@drawable/hw_ic_note" />

  <ImageView
    android:id="@+id/hw_cover"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="centerCrop"
    android:visibility="gone" />

  <ImageView
    android:layout_width="match_parent"
    android:layout_height="110dp"
    android:layout_gravity="bottom"
    android:importantForAccessibility="no"
    android:src="@drawable/hw_scrim"
    android:scaleType="fitXY" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <TextView
      android:id="@+id/hw_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/tile_label"
      android:textColor="#FFFFFFFF"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/hw_artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_idle"
      android:textColor="#CCFFFFFF"
      android:textSize="12sp" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:gravity="center"
      android:orientation="horizontal">

      <ImageButton
        android:id="@+id/hw_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/hw_button_background_light"
        android:contentDescription="@string/widget_previous"
        android:src="@drawable/hw_ic_previous_light" />

      <ImageButton
        android:id="@+id/hw_play_pause"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/hw_button_background_light"
        android:contentDescription="@string/widget_play_pause"
        android:src="@drawable/hw_ic_play_light" />

      <ImageButton
        android:id="@+id/hw_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/hw_button_background_light"
        android:contentDescription="@string/widget_next"
        android:src="@drawable/hw_ic_next_light" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
