+  private func videoURL() async -> URL? {
+    if FileManager.default.fileExists(atPath: destination.path) {
+      return destination
+    }
+    return await encodeTaskValue().value
+  }
+
+  private func encodeTaskValue() -> Task<URL?, Never> {
+    lock.lock()
+    defer { lock.unlock() }
+    if let encodeTask {
+      return encodeTask
+    }
+    let created = Task.detached(priority: .utility) {
+      await self.encode()
+    }
+    encodeTask = created
+    return created
+  }
+
+  private func encode() async -> URL? {
+    defer {
+      lock.lock()
+      data = nil
+      lock.unlock()
+    }
+    if FileManager.default.fileExists(atPath: destination.path) {
+      return destination
