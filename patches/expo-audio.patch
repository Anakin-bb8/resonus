+    }
+    let tall = variant(id: id, ratio: .tall, sourceSize: sourceSize, frame: frame, url: url, data: data)
+    return (square: square, tall: tall)
+  }
+
+  private static func variant(
+    id: String,
+    ratio: Ratio,
+    sourceSize: CGSize,
+    frame: CGImage,
+    url: URL,
+    data: Data
+  ) -> MPMediaItemAnimatedArtwork? {
+    guard let destination = cacheFile(id: id, ratio: ratio) else {
+      return nil
+    }
