+      }
+      try? await Task.sleep(nanoseconds: 4_000_000)
+    }
+    return true
+  }
+
+  private func pixelBuffer(
+    adaptor: AVAssetWriterInputPixelBufferAdaptor,
+    frame: CGImage,
+    canvas: CGSize,
+    backdrop: CGImage?
