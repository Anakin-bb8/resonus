+    guard let lastIndex = schedule.samples.last?.index,
+          let lastFrame = CGImageSourceCreateImageAtIndex(source, lastIndex, Self.frameOptions),
+          let lastBuffer = pixelBuffer(adaptor: adaptor, frame: lastFrame, canvas: canvas, backdrop: backdrop),
+          await isReady(input, writer: writer)
