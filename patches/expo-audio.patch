@@ -0,0 +1,77 @@
+package expo.modules.audio.service
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.net.Uri
+import android.util.LruCache
+import androidx.media3.common.util.BitmapLoader
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.datasource.DataSourceBitmapLoader
+import com.google.common.util.concurrent.FutureCallback
+import com.google.common.util.concurrent.Futures
+import com.google.common.util.concurrent.ListenableFuture
+import com.google.common.util.concurrent.MoreExecutors
+
+/**
+ * The media session's artwork loader, able to have a cover ready before the
+ * track it belongs to starts (#139).
+ *
+ * media3 publishes a track change to the platform session straight away, with
+ * no picture if the cover's future is not done yet, and again once it is. The
+ * Bluetooth stack forwards both, but a car told "new track, no cover" does not
+ * always come back for the second one: a Tesla keeps showing nothing. A cover
+ * fetched while the previous track plays is a done future, so the title and
+ * the picture reach the car in the same update.
+ */
+@UnstableApi
+internal class PreloadingBitmapLoader(context: Context) : BitmapLoader {
+  private val delegate = loaderFor(context)
+
+  override fun supportsMimeType(mimeType: String): Boolean = delegate.supportsMimeType(mimeType)
+
+  override fun decodeBitmap(data: ByteArray): ListenableFuture<Bitmap> = delegate.decodeBitmap(data)
+
+  override fun loadBitmap(uri: Uri): ListenableFuture<Bitmap> {
+    ready.get(uri.toString())?.let { return Futures.immediateFuture(it) }
+    return load(delegate, uri)
+  }
+
+  companion object {
+    /** A few: the track playing, the one queued behind it, and some slack. */
+    private val ready = LruCache<String, Bitmap>(4)
+
+    @Volatile private var shared: BitmapLoader? = null
+
+    private fun loaderFor(context: Context): BitmapLoader =
+      shared ?: synchronized(this) {
+        shared ?: DataSourceBitmapLoader.Builder(context.applicationContext)
+          // The session scales it down again to its own limit.
+          .setMaximumOutputDimension(1024)
+          .build()
+          .also { shared = it }
+      }
+
+    private fun load(loader: BitmapLoader, uri: Uri): ListenableFuture<Bitmap> {
+      val key = uri.toString()
+      val future = loader.loadBitmap(uri)
+      Futures.addCallback(
+        future,
+        object : FutureCallback<Bitmap> {
+          override fun onSuccess(result: Bitmap) {
+            ready.put(key, result)
+          }
+
+          override fun onFailure(t: Throwable) {}
+        },
+        MoreExecutors.directExecutor()
+      )
+      return future
+    }
+
+    /** Fetches a cover ahead of its track. Does nothing if it is already here. */
+    fun preload(context: Context, uri: Uri?) {
+      if (uri == null || ready.get(uri.toString()) != null) return
+      load(loaderFor(context), uri)
+    }
+  }
+}
